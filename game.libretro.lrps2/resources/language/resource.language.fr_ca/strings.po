msgstr ""

msgctxt "#30029"
msgid "Software (SW)"
msgstr ""

msgctxt "#30030"
msgid "Video > Internal Resolution (Restart)"
msgstr ""

msgctxt "#30031"
msgid "Video > paraLLEl super sampling"
msgstr ""

msgctxt "#30032"
msgid "Apply supersampled anti-aliasing (SSAA). Unlike straight upscaling, supersampling retains a coherent visual look where 3D elements have similar resolution as UI elements. For high-res scanout upscaling to work, you need at least '4x SSAA ordered' (or higher). Setting this to 'Native' disables super sampling."
msgstr ""

msgctxt "#30033"
msgid "Video > paraLLEl experimental High-res scanout"
msgstr ""

msgctxt "#30034"
msgid "Allows upscaling with paraLLEl. Doesn't work with every game, some might require patches on top. Requires Supersampling to be set to at least 4x SSAA ordered or higher for it to work."
msgstr ""

msgctxt "#30035"
msgid "Video > paraLLEl experimental SSAA texture"
msgstr ""

msgctxt "#30036"
msgid "Feedback higher resolution textures. May help high-res scanout image quality. Highly experimental and may cause rendering glitches."
msgstr ""

msgctxt "#30037"
msgid "Video > paraLLEl experimental sharp backbuffer"
msgstr ""

msgctxt "#30038"
msgid "Attempts to workaround games that add extra blit passes before scanning out. May lead to better image quality in certain games which do this."
msgstr ""

msgctxt "#30039"
msgid "Video > Force Texture LOD0"
msgstr ""

msgctxt "#30040"
msgid "Disable this for traditional hardware mipmapping. Enabling this will bypass mipmapping and always use texture LOD0 instead. The result is better image quality. Only a small handful of games have graphics rendering issues with this enabled."
msgstr ""

msgctxt "#30041"
msgid "Video > Deinterlacing"
msgstr ""

msgctxt "#30042"
msgid "Select a deinterlacing method. Use 'Automatic' if unsure what to pick."
msgstr ""

